#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"

VERSION="$(${PYTHON:-python3} - <<'PY'
import json
from pathlib import Path

manifest = json.loads(
    Path("custom_components/school_year/manifest.json").read_text(encoding="utf-8")
)
print(manifest["version"])
PY
)"

if ! grep -Fqx "## ${VERSION}" CHANGELOG.md; then
  printf 'Missing CHANGELOG.md section for %s\n' "${VERSION}" >&2
  exit 1
fi

if [[ -n "$(git status --porcelain)" ]]; then
  printf 'Release checkout is not clean.\n' >&2
  exit 1
fi

if [[ "$(git branch --show-current)" != "main" ]]; then
  printf 'Release checkout is not on main.\n' >&2
  exit 1
fi

if [[ "$(git rev-parse HEAD)" != "$(git rev-parse origin/main)" ]]; then
  printf 'Local main does not match origin/main.\n' >&2
  exit 1
fi

if git show-ref --verify --quiet "refs/tags/v${VERSION}"; then
  printf 'Release tag v%s already exists.\n' "${VERSION}" >&2
  exit 1
fi

./scripts/validate

printf 'RELEASE CHECK PASS: v%s\n' "${VERSION}"
