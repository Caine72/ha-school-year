#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"

fail() {
  printf '%s\n' "$1" >&2
  exit 1
}

[[ -z "$(git status --porcelain)" ]] || fail "Release checkout is not clean."
[[ "$(git branch --show-current)" == "main" ]] || fail "Release checkout is not on main."

git fetch --quiet origin main --tags
[[ "$(git rev-parse HEAD)" == "$(git rev-parse origin/main)" ]] ||
  fail "Local main does not match origin/main."

VERSION="$(${PYTHON:-python3} - <<'PY'
import json
from pathlib import Path

manifest = json.loads(
    Path("custom_components/school_year/manifest.json").read_text(encoding="utf-8")
)
print(manifest["version"])
PY
)"

REPOSITORY="$(gh repo view --json nameWithOwner --jq .nameWithOwner)"
LATEST_TAG="$(
  gh release list \
    --repo "${REPOSITORY}" \
    --exclude-drafts \
    --exclude-pre-releases \
    --limit 1 \
    --json tagName \
    --jq '.[0].tagName'
)"
[[ -n "${LATEST_TAG}" ]] || fail "No previous stable GitHub release was found."

${PYTHON:-python3} - "${VERSION}" "${LATEST_TAG#v}" <<'PY'
import re
import sys

current, previous = sys.argv[1:]
pattern = re.compile(r"^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)$")


def parse(value: str) -> tuple[int, int, int]:
    match = pattern.fullmatch(value)
    if match is None:
        raise SystemExit(f"Not a stable semantic version: {value}")
    return tuple(map(int, match.groups()))


if parse(current) <= parse(previous):
    raise SystemExit(
        f"Manifest version {current} must be newer than latest release {previous}"
    )
PY

if git show-ref --verify --quiet "refs/tags/v${VERSION}"; then
  fail "Release tag v${VERSION} already exists."
fi

CHECKS_FILE="$(mktemp)"
trap 'rm -f "${CHECKS_FILE}"' EXIT
gh api "repos/${REPOSITORY}/commits/$(git rev-parse HEAD)/check-runs?per_page=100" \
  > "${CHECKS_FILE}"

${PYTHON:-python3} - "${CHECKS_FILE}" <<'PY'
import json
import sys

required = {"HACS", "Hassfest", "Project validation"}
with open(sys.argv[1], encoding="utf-8") as file:
    runs = json.load(file)["check_runs"]

latest = {}
for run in sorted(runs, key=lambda item: item.get("started_at") or ""):
    if run["name"] in required:
        latest[run["name"]] = run

failures = [
    name
    for name in sorted(required)
    if name not in latest or latest[name]["conclusion"] != "success"
]
if failures:
    raise SystemExit("Required checks are not successful: " + ", ".join(failures))
PY

printf 'RELEASE CHECK PASS: v%s after %s\n' "${VERSION}" "${LATEST_TAG}"
